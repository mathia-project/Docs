# PostgreSQL
POSTGRES_DB=mathia
POSTGRES_USER=mathia
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432

# Directus
DIRECTUS_VERSION=11.16.0
DIRECTUS_SECRET=replace-with-at-least-32-random-characters
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_PORT=8055
DIRECTUS_CORS_ORIGIN=http://localhost:5173
DIRECTUS_PROJECT_OWNER=admin@example.com
DIRECTUS_PROJECT_USAGE=community
DIRECTUS_PRODUCT_UPDATES=false

# Initial data created automatically after Directus becomes healthy
SEED_MODE=demo
SEED_SCHOOL_NAME=Mathia School
SEED_SCHOOL_CODE=MATHIA
SEED_SCHOOL_SLUG=mathia-school
SEED_DEFAULT_LANGUAGE=es
SEED_TIME_ZONE=Europe/Madrid
SEED_EDUCATIONAL_SYSTEM=ES

SEED_DIRECTOR_EMAIL=director@example.com
SEED_DIRECTOR_PASSWORD=replace-with-a-strong-director-password
SEED_DIRECTOR_FIRST_NAME=Ana
SEED_DIRECTOR_LAST_NAME=Directora
SEED_DIRECTOR_EMPLOYEE_ID=DIR-001

SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=replace-with-a-strong-teacher-password
SEED_TEACHER_FIRST_NAME=Sofía
SEED_TEACHER_LAST_NAME=Martínez
SEED_TEACHER_EMPLOYEE_ID=EMP-001

SEED_CLASS_NAME=1º Secundaria A
SEED_CLASS_CODE=1SEC-A
SEED_CLASS_ACADEMIC_YEAR=2025-2026
SEED_CLASS_GRADE_LEVEL=grade-7

# JSON array; add or remove students as needed before first startup.
SEED_STUDENTS_JSON=[{"email":"student@example.com","password":"replace-with-a-strong-student-password","firstName":"Lucas","lastName":"García","externalId":"ALU-001"},{"email":"student2@example.com","password":"replace-with-a-strong-student-password","firstName":"Emma","lastName":"Rodríguez","externalId":"ALU-002"}]

# AI service
AI_SERVICE_PORT=8000
AI_CORS_ORIGINS=http://localhost:5173

# Local generation uses the mock provider; cloud credentials are not required.

# SolidJS SPA
APP_PORT=5173
VITE_DIRECTUS_URL=http://localhost:8055
VITE_AI_SERVICE_URL=http://localhost:8000
