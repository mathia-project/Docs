{
  "name": "mathia-pedagogical-report-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@directus/sdk": "25.0.1",
    "@solidjs/router": "1.0.0",
    "katex": "^0.16.22",
    "markdown-it": "15.0.2",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.0.0",
    "eslint-plugin-solid": "0.17.0",
    "globals": "17.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11"
  }
}
